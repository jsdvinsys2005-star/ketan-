<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Student Resume Builder - Part 2</title>

<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#eef1f5;
    color:#222;
}

.container{
    width:95%;
    max-width:950px;
    margin:25px auto;
    background:white;
    padding:25px;
    border-radius:12px;
    box-shadow:0 4px 15px #bbb;
}

h1{
    text-align:center;
    color:#17365d;
}

h2{
    color:#17365d;
    border-bottom:2px solid #17365d;
    padding-bottom:6px;
}

input, textarea, select{
    width:100%;
    padding:11px;
    margin:6px 0 14px;
    border:1px solid #bbb;
    border-radius:6px;
    font-size:15px;
}

textarea{
    min-height:90px;
    resize:vertical;
}

button{
    border:0;
    padding:12px 18px;
    border-radius:6px;
    background:#17365d;
    color:white;
    cursor:pointer;
    font-size:16px;
    margin:5px;
}

button:hover{
    background:#0b2848;
}

.red{
    background:#c62828;
}

.green{
    background:#16803c;
}

.center{
    text-align:center;
}

.hidden{
    display:none !important;
}

.message{
    text-align:center;
    font-weight:bold;
    margin:10px;
}

.photo-preview{
    width:120px;
    height:120px;
    border-radius:50%;
    object-fit:cover;
    border:3px solid #17365d;
    display:block;
    margin:10px auto;
}

/* Resume */

#resume{
    width:95%;
    max-width:900px;
    margin:30px auto;
    background:white;
    padding:40px;
    box-shadow:0 4px 15px #aaa;
    display:none;
}

.resume-header{
    display:flex;
    align-items:center;
    gap:25px;
    border-bottom:3px solid #17365d;
    padding-bottom:20px;
}

.resume-photo{
    width:120px;
    height:120px;
    object-fit:cover;
    border-radius:50%;
    border:3px solid #17365d;
}

.resume-name{
    font-size:32px;
    font-weight:bold;
    color:#17365d;
}

.contact{
    margin-top:8px;
    line-height:1.6;
}

.section{
    margin-top:22px;
}

.section-title{
    color:#17365d;
    border-bottom:2px solid #17365d;
    padding-bottom:5px;
}

.section-content{
    white-space:pre-line;
    line-height:1.6;
}

/* Template 2 */

.template2{
    font-family:Georgia,serif;
}

.template2 .resume-header{
    background:#f3f3f3;
    padding:20px;
    border-bottom:5px solid #222;
}

.template2 .resume-name,
.template2 .section-title{
    color:#222;
}

/* Template 3 */

.template3{
    font-family:Verdana,sans-serif;
}

.template3 .resume-header{
    background:#eaf4ff;
    border-left:8px solid #17365d;
    padding:20px;
}

.template3 .resume-name,
.template3 .section-title{
    color:#17365d;
}

.result-box{
    background:#eef7ee;
    padding:12px;
    border-radius:6px;
    margin-bottom:15px;
    font-weight:bold;
}

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
}

@media(max-width:600px){
    .resume-header{
        flex-direction:column;
        text-align:center;
    }

    #resume{
        padding:20px;
    }

    .resume-name{
        font-size:25px;
    }
}

@media print{
    body{
        background:white;
    }

    #loginPage,
    #registerPage,
    #builderPage,
    .print-controls{
        display:none !important;
    }

    #resume{
        display:block !important;
        width:100%;
        max-width:100%;
        margin:0;
        box-shadow:none;
    }
}
</style>
</head>

<body>


<!-- ================= LOGIN ================= -->

<div id="loginPage" class="container">

<h1>🎓 Student Resume Builder</h1>

<h2>Student Login</h2>

<input type="text" id="loginUsername"
placeholder="Username">

<input type="password" id="loginPassword"
placeholder="Password">

<div class="center">
<button onclick="login()">Login</button>
</div>

<p id="loginMessage" class="message"></p>

<div class="center">
<p>New Student?</p>
<button class="green" onclick="showRegister()">
Create New Account
</button>
</div>

</div>


<!-- ================= REGISTER ================= -->

<div id="registerPage" class="container hidden">

<h1>Student Registration</h1>

<input type="text" id="regName"
placeholder="Full Name">

<input type="text" id="regUsername"
placeholder="Create Username">

<input type="password" id="regPassword"
placeholder="Create Password">

<input type="text" id="regPhone"
placeholder="Mobile Number">

<input type="email" id="regEmail"
placeholder="Email Address">

<div class="center">
<button onclick="register()">Register</button>

<button class="red" onclick="showLogin()">
Back to Login
</button>
</div>

<p id="registerMessage" class="message"></p>

</div>


<!-- ================= BUILDER ================= -->

<div id="builderPage" class="container hidden">

<div class="topbar">

<h1>Resume Builder</h1>

<button class="red" onclick="logout()">
Logout
</button>

</div>


<h2>Personal Details</h2>

<input type="text" id="name"
placeholder="Full Name">

<input type="text" id="phone"
placeholder="Mobile Number">

<input type="email" id="email"
placeholder="Email Address">

<input type="text" id="address"
placeholder="Address">

<input type="text" id="linkedin"
placeholder="LinkedIn Profile">

<h2>Profile Photo</h2>

<input type="file"
id="photo"
accept="image/*"
onchange="loadPhoto(event)">

<img id="photoPreview"
class="photo-preview hidden">


<h2>Career Objective</h2>

<textarea id="objective"
placeholder="Write your career objective"></textarea>


<h2>Education</h2>

<input type="text" id="degree"
placeholder="Degree / Course">

<input type="text" id="college"
placeholder="College / University">

<input type="text" id="passingYear"
placeholder="Passing Year">

<h3>Marks / Percentage</h3>

<input type="number"
id="obtained"
placeholder="Obtained Marks">

<input type="number"
id="total"
placeholder="Total Marks">

<button onclick="calculatePercentage()">
Calculate Percentage
</button>

<div id="percentageResult" class="result-box hidden">
Percentage: 0%
</div>

<h3>CGPA (Optional)</h3>

<input type="number"
id="cgpa"
step="0.01"
min="0"
max="10"
placeholder="Enter CGPA">

<button onclick="calculateCGPA()">
Convert CGPA to Percentage
</button>

<div id="cgpaResult" class="result-box hidden">
CGPA Percentage: 0%
</div>


<h2>Technical Skills</h2>

<textarea id="skills"
placeholder="Example:
HTML
CSS
Java
Python
SQL
Git"></textarea>


<h2>Projects</h2>

<textarea id="projects"
placeholder="Project Name:
Smart Irrigation and Water Control System

Description:
Automatic water control system using ESP32,
relay, motor and Bluetooth."></textarea>


<h2>Experience / Training</h2>

<textarea id="experience"
placeholder="Enter internship, training or work experience"></textarea>


<h2>Certifications</h2>

<textarea id="certifications"
placeholder="Enter your certificates"></textarea>


<h2>Strengths</h2>

<textarea id="strengths"
placeholder="Example:
Quick Learner
Problem Solving
Teamwork
Communication"></textarea>


<h2>Languages</h2>

<input type="text"
id="languages"
placeholder="Gujarati, Hindi, English">


<h2>Choose Resume Template</h2>

<select id="template">
<option value="template1">Template 1 - Professional</option>
<option value="template2">Template 2 - Classic</option>
<option value="template3">Template 3 - Modern</option>
</select>


<div class="center">

<button class="green"
onclick="saveData()">
💾 Save Details
</button>

<button onclick="generateResume()">
📄 Generate Resume
</button>

</div>

<p id="saveMessage" class="message"></p>

</div>


<!-- ================= RESUME ================= -->

<div id="resume">

<div class="resume-header">

<img id="rPhoto"
class="resume-photo hidden">

<div>

<div id="rName"
class="resume-name">
Student Name
</div>

<div class="contact">
📱 <span id="rPhone"></span><br>
📧 <span id="rEmail"></span><br>
📍 <span id="rAddress"></span><br>
🔗 <span id="rLinkedin"></span>
</div>

</div>

</div>


<div class="section">

<h2 class="section-title">
CAREER OBJECTIVE
</h2>

<div id="rObjective"
class="section-content">
</div>

</div>


<div class="section">

<h2 class="section-title">
EDUCATION
</h2>

<div class="section-content">

<strong id="rDegree"></strong><br>

<span id="rCollege"></span><br>

Passing Year:
<span id="rYear"></span><br>

Marks:
<span id="rMarks"></span><br>

CGPA:
<span id="rCGPA"></span>

</div>

</div>


<div class="section">

<h2 class="section-title">
TECHNICAL SKILLS
</h2>

<div id="rSkills"
class="section-content">
</div>

</div>


<div class="section">

<h2 class="section-title">
PROJECTS
</h2>

<div id="rProjects"
class="section-content">
</div>

</div>


<div class="section">

<h2 class="section-title">
EXPERIENCE / TRAINING
</h2>

<div id="rExperience"
class="section-content">
</div>

</div>


<div class="section">

<h2 class="section-title">
CERTIFICATIONS
</h2>

<div id="rCertifications"
class="section-content">
</div>

</div>


<div class="section">

<h2 class="section-title">
STRENGTHS
</h2>

<div id="rStrengths"
class="section-content">
</div>

</div>


<div class="section">

<h2 class="section-title">
LANGUAGES
</h2>

<div id="rLanguages"
class="section-content">
</div>

</div>

</div>


<!-- PRINT BUTTONS -->

<div class="print-controls container">

<div class="center">

<button onclick="window.print()">
🖨️ Print / Save as PDF
</button>

<button onclick="backToBuilder()">
✏️ Edit Resume
</button>

</div>

</div>


<script>

/* ================= GLOBAL ================= */

let currentUser = null;
let photoData = "";


/* ================= PAGE SWITCH ================= */

function showRegister(){

    document.getElementById("loginPage")
    .classList.add("hidden");

    document.getElementById("registerPage")
    .classList.remove("hidden");
}


function showLogin(){

    document.getElementById("registerPage")
    .classList.add("hidden");

    document.getElementById("loginPage")
    .classList.remove("hidden");
}


/* ================= REGISTER ================= */

function register(){

    let name =
    document.getElementById("regName").value.trim();

    let username =
    document.getElementById("regUsername").value.trim();

    let password =
    document.getElementById("regPassword").value;

    let phone =
    document.getElementById("regPhone").value.trim();

    let email =
    document.getElementById("regEmail").value.trim();


    if(!name || !username || !password){

        document.getElementById("registerMessage")
        .innerText =
        "Please fill Name, Username and Password.";

        return;
    }


    let users =
    JSON.parse(localStorage.getItem("resumeUsers") || "{}");


    if(users[username]){

        document.getElementById("registerMessage")
        .innerText =
        "Username already exists.";

        return;
    }


    users[username] = {

        username:username,

        password:password,

        name:name,

        phone:phone,

        email:email,

        address:"",

        linkedin:"",

        objective:"",

        degree:"",

        college:"",

        passingYear:"",

        obtained:"",

        total:"",

        percentage:"",

        cgpa:"",

        cgpaPercentage:"",

        skills:"",

        projects:"",

        experience:"",

        certifications:"",

        strengths:"",

        languages:"",

        photo:"",

        template:"template1"

    };


    localStorage.setItem(
        "resumeUsers",
        JSON.stringify(users)
    );


    document.getElementById("registerMessage")
    .innerText =
    "Registration successful! Please login.";


    setTimeout(showLogin,1000);
}


/* ================= LOGIN ================= */

function login(){

    let username =
    document.getElementById("loginUsername").value.trim();

    let password =
    document.getElementById("loginPassword").value;


    let users =
    JSON.parse(localStorage.getItem("resumeUsers") || "{}");


    if(!users[username]){

        document.getElementById("loginMessage")
        .innerText =
        "Username not found.";

        return;
    }


    if(users[username].password !== password){

        document.getElementById("loginMessage")
        .innerText =
        "Wrong password.";

        return;
    }


    currentUser = username;

    loadUserData(users[username]);


    document.getElementById("loginPage")
    .classList.add("hidden");

    document.getElementById("builderPage")
    .classList.remove("hidden");

}


/* ================= LOAD USER ================= */

function loadUserData(user){

    document.getElementById("name").value =
    user.name || "";

    document.getElementById("phone").value =
    user.phone || "";

    document.getElementById("email").value =
    user.email || "";

    document.getElementById("address").value =
    user.address || "";

    document.getElementById("linkedin").value =
    user.linkedin || "";

    document.getElementById("objective").value =
    user.objective || "";

    document.getElementById("degree").value =
    user.degree || "";

    document.getElementById("college").value =
    user.college || "";

    document.getElementById("passingYear").value =
    user.passingYear || "";

    document.getElementById("obtained").value =
    user.obtained || "";

    document.getElementById("total").value =
    user.total || "";

    document.getElementById("cgpa").value =
    user.cgpa || "";

    document.getElementById("skills").value =
    user.skills || "";

    document.getElementById("projects").value =
    user.projects || "";

    document.getElementById("experience").value =
    user.experience || "";

    document.getElementById("certifications").value =
    user.certifications || "";

    document.getElementById("strengths").value =
    user.strengths || "";

    document.getElementById("languages").value =
    user.languages || "";

    document.getElementById("template").value =
    user.template || "template1";


    photoData = user.photo || "";


    if(photoData){

        let preview =
        document.getElementById("photoPreview");

        preview.src = photoData;

        preview.classList.remove("hidden");
    }

}


/* ================= PHOTO ================= */

function loadPhoto(event){

    let file =
    event.target.files[0];

    if(!file) return;


    let reader = new FileReader();


    reader.onload = function(e){

        photoData = e.target.result;

        let preview =
        document.getElementById("photoPreview");

        preview.src = photoData;

        preview.classList.remove("hidden");

    };


    reader.readAsDataURL(file);
}


/* ================= PERCENTAGE ================= */

function calculatePercentage(){

    let obtained =
    parseFloat(document.getElementById("obtained").value);

    let total =
    parseFloat(document.getElementById("total").value);


    if(isNaN(obtained) ||
       isNaN(total) ||
       total <= 0){

        alert("Enter valid obtained and total marks.");

        return;
    }


    let percentage =
    (obtained / total) * 100;


    percentage =
    percentage.toFixed(2);


    document.getElementById("percentageResult")
    .innerText =
    "Percentage: " + percentage + "%";


    document.getElementById("percentageResult")
    .classList.remove("hidden");
}


/* ================= CGPA ================= */

function calculateCGPA(){

    let cgpa =
    parseFloat(document.getElementById("cgpa").value);


    if(isNaN(cgpa) ||
       cgpa < 0 ||
       cgpa > 10){

        alert("Enter CGPA between 0 and 10.");

        return;
    }


    /*
       Common 10-point conversion:
       Percentage = CGPA × 9.5
    */

    let percentage =
    (cgpa * 9.5).toFixed(2);


    document.getElementById("cgpaResult")
    .innerText =
    "CGPA Percentage: " + percentage + "%";


    document.getElementById("cgpaResult")
    .classList.remove("hidden");
}


/* ================= SAVE DATA ================= */

function saveData(){

    if(!currentUser){

        alert("Please login first.");

        return;
    }


    let users =
    JSON.parse(localStorage.getItem("resumeUsers") || "{}");


    users[currentUser].name =
    document.getElementById("name").value;

    users[currentUser].phone =
    document.getElementById("phone").value;

    users[currentUser].email =
    document.getElementById("email").value;

    users[currentUser].address =
    document.getElementById("address").value;

    users[currentUser].linkedin =
    document.getElementById("linkedin").value;

    users[currentUser].objective =
    document.getElementById("objective").value;

    users[currentUser].degree =
    document.getElementById("degree").value;

    users[currentUser].college =
    document.getElementById("college").value;

    users[currentUser].passingYear =
    document.getElementById("passingYear").value;

    users[currentUser].obtained =
    document.getElementById("obtained").value;

    users[currentUser].total =
    document.getElementById("total").value;

    users[currentUser].cgpa =
    document.getElementById("cgpa").value;

    users[currentUser].skills =
    document.getElementById("skills").value;

    users[currentUser].projects =
    document.getElementById("projects").value;

    users[currentUser].experience =
    document.getElementById("experience").value;

    users[currentUser].certifications =
    document.getElementById("certifications").value;

    users[currentUser].strengths =
    document.getElementById("strengths").value;

    users[currentUser].languages =
    document.getElementById("languages").value;

    users[currentUser].photo =
    photoData;

    users[currentUser].template =
    document.getElementById("template").value;


    localStorage.setItem(
        "resumeUsers",
        JSON.stringify(users)
    );


    document.getElementById("saveMessage")
    .innerText =
    "✅ Details saved successfully!";
}


/* ================= GENERATE RESUME ================= */

function generateResume(){

    let users =
    JSON.parse(localStorage.getItem("resumeUsers") || "{}");


    if(currentUser){

        saveData();

        users =
        JSON.parse(localStorage.getItem("resumeUsers") || "{}");
    }


    let user = users[currentUser];


    if(!user){

        alert("Please login first.");

        return;
    }


    /* Template */

    let resume =
    document.getElementById("resume");

    resume.classList.remove(
        "template1",
        "template2",
        "template3"
    );

    resume.classList.add(
        user.template || "template1"
    );


    /* Basic */

    document.getElementById("rName")
    .innerText =
    user.name || "";

    document.getElementById("rPhone")
    .innerText =
    user.phone || "";

    document.getElementById("rEmail")
    .innerText =
    user.email || "";

    document.getElementById("rAddress")
    .innerText =
    user.address || "";

    document.getElementById("rLinkedin")
    .innerText =
    user.linkedin || "";


    /* Photo */

    let rPhoto =
    document.getElementById("rPhoto");


    if(user.photo){

        rPhoto.src = user.photo;

        rPhoto.classList.remove("hidden");

    }else{

        rPhoto.classList.add("hidden");

    }


    /* Objective */

    document.getElementById("rObjective")
    .innerText =
    user.objective || "";


    /* Education */

    document.getElementById("rDegree")
    .innerText =
    user.degree || "";

    document.getElementById("rCollege")
    .innerText =
    user.college || "";

    document.getElementById("rYear")
    .innerText =
    user.passingYear || "";


    let marksText = "";


    if(user.obtained && user.total){

        let percentage =
        (parseFloat(user.obtained) /
        parseFloat(user.total)) * 100;

        marksText =
        user.obtained +
        " / " +
        user.total +
        " (" +
        percentage.toFixed(2) +
        "%)";

    }


    document.getElementById("rMarks")
    .innerText =
    marksText;


    document.getElementById("rCGPA")
    .innerText =
